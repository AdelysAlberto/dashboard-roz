# ── Roz — Markdown Tracker ─────────────────────────────────────────────
# Server
ROZ_HOST=0.0.0.0
ROZ_PORT=8036
# LAN gate: HTTP Basic for every non-loopback request and WebSocket handshake.
# Keep ROZ_HOST=127.0.0.1 and leave these empty for a loopback-only instance.
ROZ_USER=
ROZ_PASS=

# Comma-separated list of directories to scan for .md files (UI can add more at runtime)
ROZ_SCAN_PATHS=./docs

# Project workspace: the pi subprocess runs here (the "pod" cwd)
ROZ_PROJECT_DIR=.

# ── Services board ─────────────────────────────────────────────────────
# Directory whose children are inspected for roz-service.json manifests (the
# Services tab). Each service dir declares its units, ports and commands.
ROZ_SERVICES_DIR=
# Seconds a start/stop/restart command may run before it is killed.
ROZ_SERVICE_TIMEOUT=120

# Where 'Mark Done + move' relocates files. Empty = disable the move button.
ROZ_DONE_DIR=./docs/done

# ── pi / mypi ──────────────────────────────────────────────────────────
PI_BIN=pi
# Model used for analysis (must match one of your pi model patterns)
PI_MODEL=
# Flags replicating the mypi alias (relative paths resolve against ROZ_PROJECT_DIR)
PI_FLAGS=
# Comma-separated agent list for the dropdown. "none" = no persona, just PI_FLAGS.
# pi 1.3 removed --agent: each name resolves to <PI_AGENTS_DIR>/<name>.md and is
# injected with --append-system-prompt. Names without a file are hidden from the UI.
PI_AGENTS=none
# Directory with one <agent>.md persona per agent (see PI_AGENTS).
PI_AGENTS_DIR=
# Timeout (seconds) for a pi analysis run
PI_TIMEOUT=600
# Idle seconds after which a pi session is considered ABANDONED. Dual use:
# (1) pilot kills idle background sessions after this; (2) the monitor reports
# sessions idle beyond this as `ended` (hidden by default), so a finished
# agent never lingers as `stalled`. Requires a server restart to take effect.
PI_IDLE_TTL=1800

# ── Skills tab ─────────────────────────────────────────────────────────
# Comma-separated skill roots. Each child directory holding a SKILL.md is one
# skill. Roz only READS these trees: categories/tags live in ROZ_SKILLS_INDEX.
ROZ_SKILLS_DIRS=
# Overlay index (Roz-owned): categories, tags and the cached LLM analysis.
ROZ_SKILLS_INDEX=.roz_skills.json

# OpenAI-compatible endpoint used by the "Analyze" button and the skill chat.
ROZ_LLM_BASE_URL=
ROZ_LLM_MODEL=
ROZ_LLM_API_KEY=
ROZ_LLM_TIMEOUT=240
ROZ_LLM_MAX_SKILL_CHARS=120000

# ── Test IA tab (prompt lab) ───────────────────────────────────────────
# OpenAI-compatible endpoint the lab posts to. The form pre-fills from here and
# the operator may override URL, model and key per run. Never commit a key.
ROZ_LLM_TEST_URL=
ROZ_LLM_TEST_MODEL=
ROZ_LLM_TEST_KEY=
ROZ_LLM_TEST_TEMPERATURE=0.2
ROZ_LLM_TEST_TIMEOUT=120
# Device context appended to the user turn when the form has no better value.
ROZ_LLM_TEST_LAT=40.4618
ROZ_LLM_TEST_LON=-3.7055
ROZ_LLM_TEST_VEHICLE=moto

# ── Test Imagen tab (diffusion lab) ────────────────────────────────────
# Endpoint of the image generator. Two shapes are understood and the form can
# point at either one:
#   A1111  -> POST {url}/sdapi/v1/txt2img   (Draw Things, or a wrapper around
#             mflux-generate-qwen). Leave the URL as host:port.
#   OpenAI -> POST {url}/v1/images/generations
ROZ_IMAGE_TEST_URL=
ROZ_IMAGE_TEST_MODEL=
ROZ_IMAGE_TEST_KEY=
ROZ_IMAGE_TEST_BACKEND=auto
# Qwen-Image model card defaults: 50 steps, true CFG 4.0.
ROZ_IMAGE_TEST_STEPS=50
ROZ_IMAGE_TEST_GUIDANCE=4.0
ROZ_IMAGE_TEST_ORIENTATION=1:1
# A 20B diffusion model on a 48 GB Mac takes minutes, not seconds.
ROZ_IMAGE_TEST_TIMEOUT=600
# Where the generated PNGs land. Lossless originals; the UI downloads these.
ROZ_IMAGE_TEST_OUT=artifacts/images
